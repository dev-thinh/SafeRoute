# SafeRoute Server Environment Configuration

PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saferoute
GEMINI_API_KEY=
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Goong Map REST API Key (dùng cho tìm kiếm địa chỉ số nhà & ngõ hẻm):
# Lấy loại "API Key" tại https://account.goong.io/keys
GOONG_API_KEY=

# Google Maps Geocoding API:
GOOGLE_MAPS_API_KEY=
